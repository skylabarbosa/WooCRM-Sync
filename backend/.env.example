DATABASE_PATH=./woocrm.db
APP_ENV=demo
# Required only when APP_ENV=production. Store real values in a secret manager.
AUTH_TOKEN_SECRET=
# JSON list: [{"username":"operator","role":"operator","password_hash":"pbkdf2_sha256$iterations$base64-salt$base64-hash"}]
AUTH_USERS_JSON=[]
INTEGRATION_MODE=demo
CRM_PROVIDER=mock
CRM_WRITE_ENABLED=false
# Bounded immediate retry attempts for transient connector failures (1-5).
CONNECTOR_MAX_ATTEMPTS=3
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_ORDER_ID_PROPERTY=woocrm_order_id
HUBSPOT_EMAIL_PROPERTY=woocrm_email
HUBSPOT_TOTAL_PROPERTY=amount
HUBSPOT_CURRENCY_PROPERTY=deal_currency_code
HUBSPOT_STATUS_PROPERTY=woocrm_order_status
