DATABASE_PATH=./woocrm.db
APP_ENV=demo
# In production use an absolute path on persistent storage, for example
# /var/lib/woocrm/woocrm.db
# Required only when APP_ENV=production. Store real values in a secret manager.
AUTH_TOKEN_SECRET=
# JSON list: [{"username":"operator","role":"operator","password_hash":"pbkdf2_sha256$600000$base64-salt$base64-hash"}]
AUTH_USERS_JSON=[]
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INTEGRATION_MODE=demo
CRM_PROVIDER=mock
# Production CRM writes are permanently disabled; true is only for non-production testing.
CRM_WRITE_ENABLED=false
# Bounded immediate retry attempts for transient connector failures (1-5).
CONNECTOR_MAX_ATTEMPTS=3
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_ORDER_ID_PROPERTY=woocrm_order_id
HUBSPOT_EMAIL_PROPERTY=woocrm_email
HUBSPOT_TOTAL_PROPERTY=amount
HUBSPOT_CURRENCY_PROPERTY=deal_currency_code
HUBSPOT_STATUS_PROPERTY=woocrm_order_status
